# Copy to .env next to docker-compose.yml. Do not commit the result.

# Image tag to run. Leave as-is to use the locally built image.
IMAGE=geoverse-map-server:dev
VERSION=dev

# Host binding. Defaults to loopback on purpose: put a TLS-terminating
# reverse proxy in front (see deploy/nginx/) rather than exposing 8080
# directly. Set to 0.0.0.0 only if something else handles ingress.
BIND_ADDR=127.0.0.1
PORT=8080

# API keys, comma-separated. Empty means auth stays off — which is fine for
# a private network but not for anything reachable from the internet.
# Generate one with: openssl rand -hex 32
GEOVERSE_API_KEYS=

# Only used with `--profile postgis`.
PG_DB=gis
PG_USER=geoverse
PG_PASSWORD=
